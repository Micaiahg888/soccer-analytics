{
  "name": "Soccer Analytics",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m venv venv && venv/bin/python -m pip install Flask==3.1.3",
  "postStartCommand": "nohup venv/bin/python -m flask --app app run --port 5000 </dev/null >/tmp/soccer-analytics.log 2>&1 &",
  "forwardPorts": [
    5000
  ],
  "portsAttributes": {
    "5000": {
      "label": "Soccer Analytics",
      "onAutoForward": "openPreview"
    }
  }
}
